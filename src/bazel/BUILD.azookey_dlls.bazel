# Build file for AzooKey DLLs external repository.
# This file exports all DLLs needed for the AzooKey IME engine.

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.dll"], allow_empty = False))

# Swift resource bundles (dictionary data, N-gram tokenizer)
filegroup(
    name = "resource_bundles",
    srcs = glob([
        "AzooKeyKanaKanjiConverter_KanaKanjiConverterModuleWithDefaultDictionary.resources/**",
        "AzooKeyKanaKanjiConverter_EfficientNGram.resources/**",
    ]),
)
